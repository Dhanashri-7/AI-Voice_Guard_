<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.VoiceGuard" parent="@android:style/Theme.Material.NoActionBar">
        <!-- High-Standard Cyber Defense Window Splash -->
        <item name="android:windowBackground">@drawable/splash_window_background</item>
        <item name="android:statusBarColor">#030712</item>
        <item name="android:navigationBarColor">#030712</item>
        
        <!-- Android 12+ (API 31+) System Splash Screen Customization -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">#030712</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">@drawable/voiceguard_app_logo</item>
        <item name="android:windowSplashScreenAnimationDuration" tools:targetApi="s">1000</item>
    </style>
</resources>
